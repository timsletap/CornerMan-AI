# Model weights (Ultralytics downloads YOLO_MODEL_NAME on first use; the Docker image pre-downloads it)
*.pt
*.onnx
*.engine

# Local tool settings
.claude/

# Secrets
.env

# Media and user data
uploads/

# Eval data: clips and real labels stay local; only samples are committed
eval/clips/
eval/labels/*.json
!eval/labels/samples/

# Pose caches (fixtures under tests/ are allowed)
*.parquet
!tests/**/*.parquet

# Python virtualenv and caches
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
