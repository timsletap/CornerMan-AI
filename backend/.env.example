# Database (use "db" for Docker, "localhost" for local development)
DATABASE_URL=postgresql://cornerman:cornerman@db:5432/cornerman

# Redis (use "redis" for Docker, "localhost" for local development)
REDIS_URL=redis://redis:6379/0

# JWT
# Required in production (APP_ENV=production): >= 32 bytes and not this default; DEBUG must be false
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=cornerman-videos

# App
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MAX_TOKENS=1500
# USD per million tokens for ANTHROPIC_MODEL (used for usage.cost_usd and spend limits)
ANTHROPIC_PRICE_INPUT_PER_MTOK=4.00
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=20.00

# Vision Engine
YOLO_MODEL_NAME=yolov8m-pose.pt
VISION_FRAME_SKIP=1
STRIKE_VELOCITY_THRESHOLD=15.0
GUARD_DISTANCE_THRESHOLD=0.35
TELEGRAPH_VARIANCE_THRESHOLD=0.10

# Video Storage
VIDEO_UPLOAD_DIR=uploads/videos
STORAGE_BACKEND=local
# Lifetime of signed media URLs used by <video src> (seconds)
MEDIA_URL_TTL_SECONDS=300

# Limits
FREE_TIER_DAILY_UPLOADS=999
MAX_VIDEO_DURATION_SECONDS=1800
MAX_VIDEO_SIZE_MB=500
API_CREDIT_HOURLY_LIMIT=999.00
