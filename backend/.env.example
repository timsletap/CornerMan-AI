# Database (use "db" for Docker, "localhost" for local development)
DATABASE_URL=postgresql://cornerman:cornerman@db:5432/cornerman

# Redis (use "redis" for Docker, "localhost" for local development)
REDIS_URL=redis://redis:6379/0

# JWT
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=cornerman-videos

# App
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=1500

# Vision Engine
YOLO_MODEL_NAME=yolov8m-pose.pt
VISION_FRAME_SKIP=1
STRIKE_VELOCITY_THRESHOLD=15.0
GUARD_DISTANCE_THRESHOLD=0.35
TELEGRAPH_VARIANCE_THRESHOLD=0.10

# Video Storage
VIDEO_UPLOAD_DIR=uploads/videos
STORAGE_BACKEND=local

# Limits
FREE_TIER_DAILY_UPLOADS=999
MAX_VIDEO_DURATION_SECONDS=1800
MAX_VIDEO_SIZE_MB=2000
API_CREDIT_HOURLY_LIMIT=999.00
CLAUDE_COST_PER_CALL=0.015
