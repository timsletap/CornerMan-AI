# Database
DATABASE_URL=postgresql://cornerman:cornerman@localhost:5432/cornerman

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=cornerman-videos

# App
APP_ENV=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# Limits
FREE_TIER_DAILY_UPLOADS=3
MAX_VIDEO_DURATION_SECONDS=60
MAX_VIDEO_SIZE_MB=500
API_CREDIT_HOURLY_LIMIT=5.00
